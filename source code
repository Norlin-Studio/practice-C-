#include <iostream>
#include <cmath>
using namespace std;

int main(){
    double a, b, c;
    cin >> a >> b >> c;

    double d = b*b - 4*a*c;

    if (d > 0) {
        double sq = sqrt(d);
        cout << "x1=" << (-b+sq)/(2*a) << " x2=" << (-b-sq)/(2*a) << endl;
    } else if (d == 0) {
        cout << "there is only one root: " << -b/(2*a) << endl;
    } else {
        cout << "there is no root" << endl;
    }
}